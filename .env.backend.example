# Copy các biến cần thiết vào .env.backend.local của từng máy; không commit file local.
# DB/JWT: dùng cấu hình backend riêng của nhóm, không dùng mật khẩu thật trong file này.
DB_URL=jdbc:sqlserver://127.0.0.1:1433;databaseName=SportsCenterDB;encrypt=true;trustServerCertificate=true;
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
LOCAL_JAVA_VERSION=17

# Chỉ QR của gói 1/2/3 dùng 5000/6000/7000 VND khi bật; giá niêm yết và tiền mặt giữ nguyên.
# Hóa đơn/QR/backend cùng dùng khoản thu đã lưu theo đơn. Mặc định tắt trên máy khác.
MEMBERSHIP_DEMO_PAYMENTS_ENABLED=false

# Kết nối SePay: chọn xác thực API Key trong dashboard, key riêng tối thiểu 32 ký tự.
# URL POST: /api/v1/payments/webhooks/sepay. Cần backend HTTPS công khai để nhận webhook thật.
# Không nhập API key vào frontend, tài khoản ngân hàng cấu hình qua Cài đặt sau khi đăng nhập quản lý.
SEPAY_WEBHOOK_ENABLED=false
SEPAY_API_KEY=
