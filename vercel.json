{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/assistant.mjs": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/.*",
      "status": 404
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "regions": ["iad1"]
}
